<?xml version="1.0" encoding="utf-8"?>
<!--
    No App Startup initializer here.

    Initializers run from a ContentProvider, before Application.onCreate, so
    Hilt has not injected HiltWorkerFactory yet. An initializer that reached
    WorkManager there pinned it to the default configuration, and every
    @HiltWorker then failed to construct for the life of the process. Periodic
    work is scheduled from SanchrApp.onCreate instead.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application />
</manifest>
