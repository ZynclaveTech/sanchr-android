root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
max_line_length = 140

[*.{kt,kts}]
ij_kotlin_imports_layout = *
ktlint_standard_filename = disabled
ktlint_standard_no-wildcard-imports = enabled
ktlint_standard_function-naming = disabled  # Jetpack Compose @Composable functions use PascalCase by convention
ktlint_standard_backing-property-naming = disabled  # noisy on ViewModel _uiState patterns where public StateFlow is exposed via asStateFlow()

[*.{yml,yaml,json}]
indent_size = 2
