<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. Used as the android:theme in AndroidManifest. -->
    <style name="Theme.Sanchr" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Splash screen theme, applied to MainActivity before Compose takes over. -->
    <style name="Theme.Sanchr.Splash" parent="Theme.Sanchr">
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
