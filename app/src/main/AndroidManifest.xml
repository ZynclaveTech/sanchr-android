<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- POST_NOTIFICATIONS declared in :core:notifications manifest (the natural owner). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />

    <!--
        Declare optional hardware features so the app installs on devices
        (e.g. ChromeOS, tablets) that lack a camera/microphone. Permissions
        above imply required hardware by default; required="false" opts out.
    -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name=".SanchrApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sanchr"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Sanchr.Splash">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link handling -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="sanchr.com"
                    android:scheme="https" />
            </intent-filter>

            <!--
                System share sheet. Handled by MainActivity rather than a
                separate exported activity so App Lock already guards it:
                sharing into a locked app must not be a way past the lock.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/*" />
            </intent-filter>
        </activity>

        <!-- FCM Push Notification Service -->
        <service
            android:name="com.sanchr.core.notifications.SanchrPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Call Foreground Service -->
        <service
            android:name="com.sanchr.core.callengine.CallService"
            android:exported="false"
            android:foregroundServiceType="phoneCall|camera|microphone" />

        <!-- Notification action receiver (inline reply, mark read, call actions) -->
        <receiver
            android:name="com.sanchr.core.notifications.NotificationReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.sanchr.action.REPLY" />
                <action android:name="com.sanchr.action.MARK_READ" />
                <action android:name="com.sanchr.action.ANSWER_CALL" />
                <action android:name="com.sanchr.action.DECLINE_CALL" />
            </intent-filter>
        </receiver>

        <!-- Read-only, per-URI grants for decrypted vault items handed to a viewer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <!--
                Remove the default WorkManager initializer: SanchrApp supplies
                the Configuration carrying HiltWorkerFactory, and on-demand
                initialization asks for it at the first getInstance() call.

                Periodic work is NOT scheduled from an App Startup initializer.
                Initializers run from a ContentProvider, before
                Application.onCreate, so Hilt has not injected the factory yet;
                an initializer that touched WorkManager there would pin the
                default configuration and every @HiltWorker would fail to
                construct for the life of the process.
            -->
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!--
            Sentry auto-initialises itself from a ContentProvider, which runs
            before Application.onCreate. That is exactly wrong here twice
            over: it would start the SDK before CrashReporter has looked at
            the user's consent, and with no DSN in the manifest (the default,
            because the DSN is injected at build time) it throws
            "DSN is required" and takes the process down at launch.

            CrashReporter calls SentryAndroid.init itself, after consent, so
            auto-init has nothing left to do. Both flags are set: removing
            the provider is what actually stops it, and the meta-data keeps
            it stopped if a transitive dependency reintroduces the provider.
        -->
        <meta-data
            android:name="io.sentry.auto-init"
            android:value="false" />

        <provider
            android:name="io.sentry.android.core.SentryInitProvider"
            android:authorities="${applicationId}.SentryInitProvider"
            tools:node="remove" />

        <provider
            android:name="io.sentry.android.core.SentryPerformanceProvider"
            android:authorities="${applicationId}.SentryPerformanceProvider"
            tools:node="remove" />
    </application>

</manifest>
